# Copy to `.env` and adjust. `.env` is git-ignored: never commit it.
# The scripts source it when it exists.

IMAGE=swift-tensorfold:local
MODEL=ukisai/Swift-1.5-Qwen3.8-Flash-Next-NVFP4

HOST=0.0.0.0
PORT=8083
NAME=swift-1.5

# Host directories. The checkpoint is 186 GB; the image another 40 GB.
HF_DIR=$HOME/.cache/swift-tensorfold/hf        # Hugging Face cache (the checkpoint lands here)
STATE_DIR=$HOME/.cache/swift-tensorfold/state  # triton/torch kernel caches, prefix snapshots
MODELS_DIR=$HOME/models                        # optional local checkpoints, mounted read-only

# Only needed when Hugging Face asks for it (gated or rate-limited access). Leave empty to stay anonymous.
HF_TOKEN=

# Extra `tensorfold serve` flags, word-split as they are here. Options that matter on 128 GB:
#   EXTRA_ARGS="--ple-on-ssd"                   # n-gram tables stay on disk: ~40 GiB less peak
#   EXTRA_ARGS="--ple-on-ssd --ssd-experts 90"  # plus routed experts streamed into a 90 GiB pool
#   EXTRA_ARGS="--mtp-drafts 6"                 # MTP drafts a round (the CUDA default; 0 disables)
#   EXTRA_ARGS="--parallel 2"                   # requests decoded together (Flash Next, one rank)
#   EXTRA_ARGS="--no-drafts"                    # serial reference; also avoids draft-vocab IndexError on this tip
# Spark default: keep the BF16 n-gram table on SSD so weights + caches fit in 128 GB.
# Quote the value when it has multiple flags so `set -a; . .env` does not execute them.
EXTRA_ARGS="--ple-on-ssd --mtp-drafts 10 --mtp-confidence 0.20 --no-thinking --context 8192"

# Fork tip with lossless 12-bit BF16 faces (pack12 / fused _b12mm). Override to A/B:
TF_REPO=https://github.com/tournierjc/TensorFold.git
TF_REF=e125826475cdc6e62e35079f4dd501fa3f06c418

# Optional decode-face copies (unset = none). Prefer 12-bit for bit-exact; FP8 is lossy.
# TENSORFOLD_FACES_12BIT=1
# TENSORFOLD_FACES_12BIT=all
# TENSORFOLD_FACES_FP8=all

# PLE n-gram page prefetch: optional only. Warm Spark A/B was flat (ON≈OFF ~39.6/85.9/1705).
# TENSORFOLD_PLE_PREFETCH=0

# Crash diagnosis. TORCH_USE_CUDA_DSA=1 (a device-side assert names the faulting kernel),
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True (fragmentation), CUDA_LAUNCH_BLOCKING=1
# (serialised launches; keep off while graphs are captured). Forwarded only when set.
TORCH_USE_CUDA_DSA=0

# Set to 1 to skip prompt-kernel warm on first serve (Spark NVFP4 MoE IMA workaround while iterating).
# First real request pays the warm cost instead.
# TENSORFOLD_SKIP_WARM=1

# Optional MoE backend override (grouped default; python = host item loop):
# TENSORFOLD_NVFP4_MOE=grouped
